# Production: Neon — https://console.neon.tech (pooled connection string)
# Local development: pglite://.pglite runs Postgres in-process, nothing to install
DATABASE_URL="pglite://.pglite"

# Enables /dev-login, which signs in without Google. Never in production.
DEV_LOGIN="true"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Allowlist: only these e-mails can sign in. Comma separated.
ALLOWED_EMAILS="voce@gmail.com,suairma@gmail.com"
